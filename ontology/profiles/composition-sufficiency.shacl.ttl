# SPDX-License-Identifier: CC0-1.0
#
# composition-sufficiency profile — Federated Audit and Composition §Profiles.
# Every composed scope MUST carry a rtm:CompositionSufficiencyAttestation, AND
# the signer-count threshold from the attached SufficiencyCriteria MUST be met
# by the count of rtm:ScopeCertificationAttestation instances on the composed
# scope's constituents (counted via rtm:attests + the composition predicates).
#
# The SPARQL here is the minimum gate: the attestation must exist. The deeper
# signer-count check is decomposed into a helper in oracle/composition/levels.py
# so adopters can refine it without touching SHACL.

@prefix rtm: <https://flexo-rtm.dev/ontology#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .

rtm:CompositionSufficiencyShape
    a sh:NodeShape ;
    sh:targetClass rtm:Scope ;
    sh:sparql [
        sh:message "Composed scope must carry an rtm:CompositionSufficiencyAttestation (composition-sufficiency profile)" ;
        sh:select """
            PREFIX rtm: <https://flexo-rtm.dev/ontology#>
            SELECT $this WHERE {
                { $this rtm:union ?p } UNION { $this rtm:extends ?p } UNION { $this rtm:intersectsWith ?p }
                FILTER NOT EXISTS {
                    ?att a rtm:CompositionSufficiencyAttestation ;
                         rtm:attests $this .
                }
            }
        """
    ] .
