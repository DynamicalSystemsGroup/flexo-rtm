# SPDX-License-Identifier: CC0-1.0
#
# OSLC-RM roundtrip profile — OSLC Roundtrip Acceptance §9.
# Requires that every oslc_rm:Requirement carries dcterms:identifier and
# dcterms:title (minimum metadata for OSLC interop). Stronger constraints
# (per-link-type domain/range) can be added incrementally per §10.

@prefix oslc_rm: <http://open-services.net/ns/rm#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

[] a sh:NodeShape ;
    sh:targetClass oslc_rm:Requirement ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:message "OSLC-RM Requirement must carry dcterms:identifier"
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:message "OSLC-RM Requirement must carry dcterms:title"
    ] .
