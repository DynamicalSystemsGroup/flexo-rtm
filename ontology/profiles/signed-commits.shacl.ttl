#
# signed-commits profile — Signed Envelope Shapes §4 + Design Spec §6.5 S1.
# Off by default. Activation = data graph runs with this shape attached.
# Every rtm:Attestation MUST cite the introducing commit + signature key, and
# that signature key MUST match a public key declared on rtm:approvedBy.

@prefix rtm: <https://flexo-rtm.dev/ontology#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .

rtm:SignedCommitsShape
    a sh:NodeShape ;
    sh:targetClass rtm:Attestation ;
    sh:property [
        sh:path rtm:introducedByCommit ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Attestation must cite its introducing commit (signed-commits profile)"
    ] ;
    sh:sparql [
        sh:message "Attestation's introducing commit must be signed by a key matching the approver's published key fingerprint" ;
        sh:select """
            PREFIX rtm: <https://flexo-rtm.dev/ontology#>
            SELECT $this WHERE {
                $this rtm:approvedBy ?approver ;
                      rtm:introducedByCommit ?commit .
                ?commit rtm:signedByKey ?keyFingerprint .
                FILTER NOT EXISTS {
                    ?approver rtm:hasPublicKey ?key .
                    ?key rtm:keyFingerprint ?keyFingerprint .
                }
            }
        """
    ] .
