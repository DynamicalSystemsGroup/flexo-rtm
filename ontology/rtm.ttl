<https://flexo-rtm.dev/ontology> a owl:Ontology ;
    rdfs:label "flexo-rtm core ontology (slice 1 skeleton)" ;
    owl:versionInfo "0.0.1" .

rtm:AdequacyAttestation a owl:Class ;
    rdfs:label "Adequacy attestation (over an artifact/requirement pair)" ;
    rdfs:subClassOf rtm:Attestation .

rtm:SatisfactionAttestation a owl:Class ;
    rdfs:label "Satisfaction attestation (over an rtm:addresses edge)" ;
    rdfs:subClassOf rtm:Attestation .

rtm:SufficiencyAttestation a owl:Class ;
    rdfs:label "Sufficiency attestation (over an artifact/requirement pair)" ;
    rdfs:subClassOf rtm:Attestation .

rtm:appliesTo a owl:ObjectProperty ;
    rdfs:label "appliesTo (attestation → subject IRI; requirement for SatisfactionAttestation)" ;
    rdfs:domain rtm:Attestation .

rtm:appliesToRole a owl:ObjectProperty ;
    rdfs:label "appliesToRole" ;
    rdfs:domain rtm:Policy .

rtm:approvedBy a owl:ObjectProperty ;
