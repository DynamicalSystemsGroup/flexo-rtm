    rdfs:label "RequirementDefinition (class of requirements; analogous to oslc_rm:RequirementCollection)" ;
    rdfs:subClassOf rtm:Requirement .

rtm:TestCase a owl:Class ;
    rdfs:label "TestCase (test-as-evidence; cross-classified with oslc_qm:TestCase and omg-sysml:VerificationCaseUsage)" ;
    rdfs:subClassOf rtm:Artifact .

rtm:hasRequirement a owl:ObjectProperty ;
    rdfs:label "hasRequirement (element bears this requirement)" .

