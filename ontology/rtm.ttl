rtm:Attribute a owl:Class ;
    rdfs:label "Attribute (key/value typed by the adapter)" .

rtm:Constraint a owl:Class ;
    rdfs:label "Constraint (model-level constraint statement; from SysMLv2 omg-sysml:Constraint)" .

