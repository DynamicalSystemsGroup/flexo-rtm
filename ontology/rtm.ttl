rtm:totalContentHashes a owl:DatatypeProperty ;
    rdfs:label "totalContentHashes" ;
    rdfs:domain rtm:ReproducibilityManifest .

rtm:totalGitRefs a owl:DatatypeProperty ;
    rdfs:label "totalGitRefs (xsd:integer)" ;
    rdfs:domain rtm:ReproducibilityManifest .

rtm:totalOCIImages a owl:DatatypeProperty ;
    rdfs:label "totalOCIImages" ;
    rdfs:domain rtm:ReproducibilityManifest .

rtm:union a owl:ObjectProperty ;
    rdfs:label "union (disjunctive composition; rare)" ;
    rdfs:domain rtm:Scope ;
    rdfs:range rtm:Scope .

rtm:verifies a owl:ObjectProperty ;
    rdfs:label "verifies (TestCase → Requirement; complementary to rtm:addresses for SysMLv2 VerificationCaseUsage)" .

