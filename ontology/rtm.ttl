@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rtm: <https://flexo-rtm.dev/ontology#> .

dcat:Distribution a owl:Class ;
    rdfs:label "Distribution (optional)" .

dcat:downloadURL a owl:ObjectProperty ;
    rdfs:label "downloadURL (mirror / fetch URL; informational)" .

earl:assertedBy a owl:ObjectProperty ;
    rdfs:domain earl:Assertion .

earl:cantTell a earl:TestResult ;
    rdfs:label "cantTell" .

earl:failed a earl:TestResult ;
    rdfs:label "failed" .

earl:inapplicable a earl:TestResult ;
    rdfs:label "inapplicable" .

earl:passed a earl:TestResult ;
    rdfs:label "passed" .

earl:result a owl:ObjectProperty ;
    rdfs:domain earl:Assertion ;
    rdfs:range earl:TestResult .

earl:subject a owl:ObjectProperty ;
    rdfs:domain earl:Assertion .

earl:test a owl:ObjectProperty ;
    rdfs:domain earl:Assertion ;
    rdfs:range earl:TestCriterion .

earl:untested a earl:TestResult ;
    rdfs:label "untested" .

org:OrganizationalUnit a owl:Class ;
    rdfs:label "OrganizationalUnit" ;
    rdfs:subClassOf org:Organization .

org:hasMembership a owl:ObjectProperty ;
    rdfs:label "hasMembership" .

org:memberOf a owl:ObjectProperty ;
    rdfs:label "memberOf (convenience inverse)" .

org:organization a owl:ObjectProperty ;
    rdfs:label "organization" ;
    rdfs:domain org:Membership ;
    rdfs:range org:Organization .

org:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:domain org:Membership ;
    rdfs:range org:Role .

prov:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf prov:Agent .

prov:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf prov:Agent .

prov:atLocation a owl:ObjectProperty .

prov:atTime a owl:DatatypeProperty .

prov:endedAtTime a owl:DatatypeProperty .

prov:hadPlan a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Plan .

prov:specializationOf a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

prov:startedAtTime a owl:DatatypeProperty .

prov:used a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Agent .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Agent .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Activity .

prov:wasInformedBy a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Activity .

prov:wasInvalidatedBy a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Activity .

foaf:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf foaf:Agent .

foaf:mbox a owl:ObjectProperty ;
    rdfs:label "mbox" .

foaf:name a owl:DatatypeProperty ;
    rdfs:label "name" .

<https://flexo-rtm.dev/ontology> a owl:Ontology ;
    rdfs:label "flexo-rtm core ontology (slice 1 skeleton)" ;
    owl:versionInfo "0.0.1" .

rtm:Activity a owl:Class ;
    rdfs:label "Activity (a process: sim run, model build, test exec, …)" ;
    rdfs:subClassOf prov:Activity .

rtm:AdequacyAttestation a owl:Class ;
    rdfs:label "Adequacy attestation (over an artifact/requirement pair)" ;
    rdfs:subClassOf rtm:Attestation .

rtm:SatisfactionAttestation a owl:Class ;
    rdfs:label "Satisfaction attestation (over an rtm:addresses edge)" ;
    rdfs:subClassOf rtm:Attestation .

rtm:SufficiencyAttestation a owl:Class ;
    rdfs:label "Sufficiency attestation (over an artifact/requirement pair)" ;
    rdfs:subClassOf rtm:Attestation .

rtm:addresses a owl:ObjectProperty ;
    rdfs:label "addresses (artifact → requirement)" ;
    rdfs:comment """An artifact ADDRESSES a requirement — it provides evidence bearing on
whether the requirement is met. Addressing is structural and per-edge.

SATISFACTION is a separate, stronger epistemic claim: a named human, synthesizing
the available evidence, attests that a requirement is satisfied. Satisfaction is
recorded only via rtm:SatisfactionAttestation (per ADR-021) — never inferred from
addresses-edges alone. Following the Hawkins-Habli Assurance Claim Point split.""" ;
    rdfs:domain rtm:Artifact ;
    rdfs:range rtm:Requirement .

rtm:appliesTo a owl:ObjectProperty ;
    rdfs:label "appliesTo (attestation → subject IRI; requirement for SatisfactionAttestation)" ;
    rdfs:domain rtm:Attestation .

rtm:appliesToRole a owl:ObjectProperty ;
    rdfs:label "appliesToRole" ;
    rdfs:domain rtm:Policy .

rtm:approvedBy a owl:ObjectProperty ;
    rdfs:label "approvedBy (named human IRI; SHACL-enforced)" ;
    rdfs:domain rtm:Attestation .

rtm:asotHeldBy a owl:ObjectProperty ;
    rdfs:label "asotHeldBy (org IRI; ADR-030)" ;
    rdfs:domain rtm:Scope .

rtm:attributeKey a owl:DatatypeProperty ;
    rdfs:label "attributeKey" .

rtm:attributeMinValue a owl:DatatypeProperty ;
    rdfs:label "attributeMinValue" .

rtm:attributeValue a owl:DatatypeProperty ;
    rdfs:label "attributeValue" .

rtm:contentHashes a owl:ObjectProperty ;
    rdfs:label "contentHashes (list of manifest entries)" ;
    rdfs:domain rtm:ReproducibilityManifest .

rtm:deferred a rtm:AttestationStatus ;
    rdfs:label "deferred" .

rtm:deprecated a rtm:AttestationStatus ;
    rdfs:label "deprecated" .

rtm:extends a owl:ObjectProperty ;
    rdfs:label "extends" ;
    rdfs:domain rtm:Scope ;
    rdfs:range rtm:Scope .

rtm:fail a rtm:AttestationStatus ;
    rdfs:label "fail" .

rtm:gitRefs a owl:ObjectProperty ;
    rdfs:label "gitRefs (list of manifest entries)" ;
    rdfs:domain rtm:ReproducibilityManifest .

rtm:hasAspect a owl:ObjectProperty ;
    rdfs:label "hasAspect" ;
    rdfs:range rtm:Aspect .

rtm:hasAttribute a owl:ObjectProperty ;
    rdfs:label "hasAttribute" ;
    rdfs:range rtm:Attribute .

rtm:hasContentHash a owl:DatatypeProperty ;
    rdfs:label "hasContentHash (algo:hex; suite-derived per ADR-026)" .

rtm:hasExternalIdentity a owl:DatatypeProperty ;
    rdfs:label "hasExternalIdentity (provider-prefixed identity string)" .

rtm:hasGitCommit a owl:DatatypeProperty ;
    rdfs:label "hasGitCommit (SHA-1 or SHA-256 hex)" .

rtm:hasGitPath a owl:DatatypeProperty ;
    rdfs:label "hasGitPath (path within the repo)" .

rtm:hasGitRepo a owl:DatatypeProperty ;
    rdfs:label "hasGitRepo (HTTPS URL)" .

rtm:hasOCIImage a owl:DatatypeProperty ;
    rdfs:label "hasOCIImage (registry/image@algo:digest)" .

rtm:hasQualifiedRole a owl:ObjectProperty ;
    rdfs:label "hasQualifiedRole (org → role; ADR-028 federated audit)" .

rtm:inScope a owl:ObjectProperty ;
    rdfs:label "inScope" ;
    rdfs:range rtm:Scope .

rtm:includesGraph a owl:ObjectProperty ;
    rdfs:label "includesGraph" ;
    rdfs:domain rtm:Scope .

rtm:intersectsWith a owl:ObjectProperty ;
    rdfs:label "intersectsWith" ;
    rdfs:domain rtm:Scope ;
    rdfs:range rtm:Scope .

rtm:ociImages a owl:ObjectProperty ;
    rdfs:label "ociImages (list of manifest entries)" ;
    rdfs:domain rtm:ReproducibilityManifest .

rtm:pass a rtm:AttestationStatus ;
    rdfs:label "pass" .

rtm:permitsAspect a owl:ObjectProperty ;
    rdfs:label "permitsAspect" ;
    rdfs:domain rtm:Policy ;
    rdfs:range rtm:Aspect .

rtm:permitsAttestationType a owl:ObjectProperty ;
    rdfs:label "permitsAttestationType" ;
    rdfs:domain rtm:Policy .

rtm:referencedBy a owl:ObjectProperty ;
    rdfs:label "referencedBy (manifest entry → resources that cite this URI)" .

rtm:requiresAttribute a owl:ObjectProperty ;
    rdfs:label "requiresAttribute" ;
    rdfs:domain rtm:Policy .

rtm:scopeFilter a owl:DatatypeProperty ;
    rdfs:label "scopeFilter (SPARQL FILTER fragment)" ;
    rdfs:domain rtm:Scope .

rtm:scopedTo a owl:ObjectProperty ;
    rdfs:label "scopedTo" ;
    rdfs:range rtm:Scope .

rtm:status a owl:ObjectProperty ;
    rdfs:label "status (pass | fail | deferred | deprecated)" ;
    rdfs:domain rtm:Attestation .

rtm:totalContentHashes a owl:DatatypeProperty ;
    rdfs:label "totalContentHashes" ;
    rdfs:domain rtm:ReproducibilityManifest .

rtm:totalGitRefs a owl:DatatypeProperty ;
    rdfs:label "totalGitRefs (xsd:integer)" ;
    rdfs:domain rtm:ReproducibilityManifest .

rtm:totalOCIImages a owl:DatatypeProperty ;
    rdfs:label "totalOCIImages" ;
    rdfs:domain rtm:ReproducibilityManifest .

rtm:union a owl:ObjectProperty ;
    rdfs:label "union (disjunctive composition; rare)" ;
    rdfs:domain rtm:Scope ;
    rdfs:range rtm:Scope .

rtm:withinScope a owl:ObjectProperty ;
    rdfs:label "withinScope" ;
    rdfs:domain rtm:Policy ;
    rdfs:range rtm:Scope .

earl:TestCriterion a owl:Class ;
    rdfs:label "TestCriterion" .

org:Role a owl:Class ;
    rdfs:label "Role" .

prov:Plan a owl:Class ;
    rdfs:label "Plan" .

foaf:Agent a owl:Class ;
    rdfs:label "Agent" .

rtm:Artifact a owl:Class ;
    rdfs:label "Artifact (verification evidence)" ;
    rdfs:subClassOf prov:Entity .

rtm:Attribute a owl:Class ;
    rdfs:label "Attribute (key/value typed by the adapter)" .

rtm:Requirement a owl:Class ;
    rdfs:label "Requirement" .

org:Membership a owl:Class ;
    rdfs:label "Membership" .

org:Organization a owl:Class ;
    rdfs:label "Organization" .

rtm:Aspect a owl:Class ;
    rdfs:label "Aspect (an axis a requirement is judged along: functional, safety, performance, ...)" .

earl:Assertion a owl:Class ;
    rdfs:label "Assertion" .

prov:Agent a owl:Class ;
    rdfs:label "Agent" .

rtm:AttestationStatus a owl:Class ;
    rdfs:label "AttestationStatus (one of: pass, fail, deferred, deprecated)" .

rtm:Policy a owl:Class ;
    rdfs:label "Policy (RBAC + ABAC + scope-based authorization, SPARQL-evaluable)" .

earl:TestResult a owl:Class ;
    rdfs:label "TestResult" .

rtm:Attestation a owl:Class ;
    rdfs:label "Attestation (named-approver assertion)" .

rtm:ReproducibilityManifest a owl:Class ;
    rdfs:label "ReproducibilityManifest (enumerates every external URI a cert depends on)" .

prov:Activity a owl:Class ;
    rdfs:label "Activity" .

prov:Entity a owl:Class ;
    rdfs:label "Entity" .

rtm:Scope a owl:Class ;
    rdfs:label "Scope (named graph functioning as an ASOT)" .

