    rdfs:subClassOf rtm:Artifact,
        omg-sysml:Element .

omg-sysml:PartUsage a owl:Class ;
    rdfs:label "PartUsage (designed component instance)" ;
    rdfs:subClassOf rtm:Artifact,
        omg-sysml:Element .

omg-sysml:PortUsage a owl:Class ;
    rdfs:label "PortUsage" ;
