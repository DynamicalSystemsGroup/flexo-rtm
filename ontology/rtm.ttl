    rdfs:label "TestPlan" .

oslc_qm:TestScript a owl:Class ;
    rdfs:label "TestScript" ;
    rdfs:subClassOf rtm:Artifact .

oslc_qm:blocked a oslc_qm:TestResult ;
    rdfs:label "blocked" .

