# SPDX-License-Identifier: CC0-1.0
#
# rtm: core vocabulary — slice 1 skeleton. Design Spec §4.1 + §4.2.
# Per ADR-021, v0.1 ships three per-claim attestation subclasses (composition
# subclasses come in slice 10). Status individuals per ADR-031.

@prefix rtm:  <https://flexo-rtm.dev/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://flexo-rtm.dev/ontology>
    a owl:Ontology ;
    rdfs:label "flexo-rtm core ontology (slice 1 skeleton)" ;
    owl:versionInfo "0.0.1" .

# --- traceability primitives (Design Spec §4.1) -------------------------------

rtm:Requirement
    a owl:Class ;
    rdfs:label "Requirement" .

rtm:Artifact
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Artifact (verification evidence)" .

rtm:addresses
    a owl:ObjectProperty ;
    rdfs:domain rtm:Artifact ;
    rdfs:range  rtm:Requirement ;
    rdfs:label  "addresses (artifact → requirement)" ;
    rdfs:comment """An artifact ADDRESSES a requirement — it provides evidence bearing on
whether the requirement is met. Addressing is structural and per-edge.

SATISFACTION is a separate, stronger epistemic claim: a named human, synthesizing
the available evidence, attests that a requirement is satisfied. Satisfaction is
recorded only via rtm:SatisfactionAttestation (per ADR-021) — never inferred from
addresses-edges alone. Following the Hawkins-Habli Assurance Claim Point split.""" .

# --- scope (Design Spec §5.3, ADR-007) ---------------------------------------

rtm:Scope
    a owl:Class ;
    rdfs:label "Scope (named graph functioning as an ASOT)" .

# --- attestation hierarchy (Design Spec §4.2, ADR-021) -----------------------

rtm:Attestation
    a owl:Class ;
    rdfs:label "Attestation (named-approver assertion)" .

rtm:SatisfactionAttestation
    a owl:Class ;
    rdfs:subClassOf rtm:Attestation ;
    rdfs:label "Satisfaction attestation (over an rtm:addresses edge)" .

rtm:AdequacyAttestation
    a owl:Class ;
    rdfs:subClassOf rtm:Attestation ;
    rdfs:label "Adequacy attestation (over an artifact/requirement pair)" .

rtm:SufficiencyAttestation
    a owl:Class ;
    rdfs:subClassOf rtm:Attestation ;
    rdfs:label "Sufficiency attestation (over an artifact/requirement pair)" .

# --- attestation properties --------------------------------------------------

rtm:approvedBy
    a owl:ObjectProperty ;
    rdfs:domain rtm:Attestation ;
    rdfs:label  "approvedBy (named human IRI; SHACL-enforced)" .

rtm:status
    a owl:ObjectProperty ;
    rdfs:domain rtm:Attestation ;
    rdfs:label  "status (pass | fail | deferred | deprecated)" .

# --- attestation status individuals (ADR-031) --------------------------------

rtm:pass       a rtm:AttestationStatus ; rdfs:label "pass" .
rtm:fail       a rtm:AttestationStatus ; rdfs:label "fail" .
rtm:deferred   a rtm:AttestationStatus ; rdfs:label "deferred" .
rtm:deprecated a rtm:AttestationStatus ; rdfs:label "deprecated" .

rtm:AttestationStatus
    a owl:Class ;
    rdfs:label "AttestationStatus (one of: pass, fail, deferred, deprecated)" .

# --- attestation subject + aspect (Design Spec §4.2) ------------------------

rtm:appliesTo
    a owl:ObjectProperty ;
    rdfs:domain rtm:Attestation ;
    rdfs:label  "appliesTo (attestation → subject IRI; requirement for SatisfactionAttestation)" .

rtm:Aspect
    a owl:Class ;
    rdfs:label "Aspect (an axis a requirement is judged along: functional, safety, performance, ...)" .

rtm:hasAspect a owl:ObjectProperty ; rdfs:range rtm:Aspect ; rdfs:label "hasAspect" .
rtm:inScope   a owl:ObjectProperty ; rdfs:range rtm:Scope  ; rdfs:label "inScope" .

# --- identity projection vocabulary (Identity Adapter Contract §3-§4) -------

rtm:hasExternalIdentity
    a owl:DatatypeProperty ;
    rdfs:label "hasExternalIdentity (provider-prefixed identity string)" .

rtm:Attribute
    a owl:Class ;
    rdfs:label "Attribute (key/value typed by the adapter)" .

rtm:hasAttribute   a owl:ObjectProperty   ; rdfs:range rtm:Attribute ; rdfs:label "hasAttribute" .
rtm:attributeKey   a owl:DatatypeProperty ; rdfs:label "attributeKey" .
rtm:attributeValue a owl:DatatypeProperty ; rdfs:label "attributeValue" .
rtm:scopedTo       a owl:ObjectProperty   ; rdfs:range rtm:Scope ; rdfs:label "scopedTo" .

rtm:hasQualifiedRole
    a owl:ObjectProperty ;
    rdfs:label "hasQualifiedRole (org → role; ADR-028 federated audit)" .

# --- policy projection (Identity Adapter Contract §3.4 + §5) ----------------

rtm:Policy
    a owl:Class ;
    rdfs:label "Policy (RBAC + ABAC + scope-based authorization, SPARQL-evaluable)" .

rtm:appliesToRole          a owl:ObjectProperty ; rdfs:domain rtm:Policy ; rdfs:label "appliesToRole" .
rtm:requiresAttribute      a owl:ObjectProperty ; rdfs:domain rtm:Policy ; rdfs:label "requiresAttribute" .
rtm:attributeMinValue      a owl:DatatypeProperty ; rdfs:label "attributeMinValue" .
rtm:permitsAttestationType a owl:ObjectProperty ; rdfs:domain rtm:Policy ; rdfs:label "permitsAttestationType" .
rtm:permitsAspect          a owl:ObjectProperty ; rdfs:domain rtm:Policy ; rdfs:range rtm:Aspect ; rdfs:label "permitsAspect" .
rtm:withinScope            a owl:ObjectProperty ; rdfs:domain rtm:Policy ; rdfs:range rtm:Scope ; rdfs:label "withinScope" .

# --- scope composition (Analysis Layer Scope Algebra) -----------------------
# Properties used by oracle/analysis/scope.py; declared here so they're in
# manifest. Range constraints kept loose to allow the algebra to evolve.

rtm:includesGraph     a owl:ObjectProperty ; rdfs:domain rtm:Scope ; rdfs:label "includesGraph" .
rtm:scopeFilter       a owl:DatatypeProperty ; rdfs:domain rtm:Scope ; rdfs:label "scopeFilter (SPARQL FILTER fragment)" .
rtm:extends           a owl:ObjectProperty ; rdfs:domain rtm:Scope ; rdfs:range rtm:Scope ; rdfs:label "extends" .
rtm:intersectsWith    a owl:ObjectProperty ; rdfs:domain rtm:Scope ; rdfs:range rtm:Scope ; rdfs:label "intersectsWith" .
rtm:union             a owl:ObjectProperty ; rdfs:domain rtm:Scope ; rdfs:range rtm:Scope ; rdfs:label "union (disjunctive composition; rare)" .
rtm:asotHeldBy        a owl:ObjectProperty ; rdfs:domain rtm:Scope ; rdfs:label "asotHeldBy (org IRI; ADR-030)" .

# --- external URI vocabulary (Design Spec §4.4, ADR-022) --------------------

rtm:Activity
    a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Activity (a process: sim run, model build, test exec, …)" .

rtm:hasGitRepo    a owl:DatatypeProperty ; rdfs:label "hasGitRepo (HTTPS URL)" .
rtm:hasGitCommit  a owl:DatatypeProperty ; rdfs:label "hasGitCommit (SHA-1 or SHA-256 hex)" .
rtm:hasGitPath    a owl:DatatypeProperty ; rdfs:label "hasGitPath (path within the repo)" .
rtm:hasContentHash a owl:DatatypeProperty ; rdfs:label "hasContentHash (algo:hex; suite-derived per ADR-026)" .
rtm:hasOCIImage   a owl:DatatypeProperty ; rdfs:label "hasOCIImage (registry/image@algo:digest)" .

# --- reproducibility manifest (External URI Rules §8) -----------------------

rtm:ReproducibilityManifest
    a owl:Class ;
    rdfs:label "ReproducibilityManifest (enumerates every external URI a cert depends on)" .

rtm:totalGitRefs       a owl:DatatypeProperty ; rdfs:domain rtm:ReproducibilityManifest ; rdfs:label "totalGitRefs (xsd:integer)" .
rtm:totalContentHashes a owl:DatatypeProperty ; rdfs:domain rtm:ReproducibilityManifest ; rdfs:label "totalContentHashes" .
rtm:totalOCIImages     a owl:DatatypeProperty ; rdfs:domain rtm:ReproducibilityManifest ; rdfs:label "totalOCIImages" .
rtm:gitRefs            a owl:ObjectProperty   ; rdfs:domain rtm:ReproducibilityManifest ; rdfs:label "gitRefs (list of manifest entries)" .
rtm:contentHashes      a owl:ObjectProperty   ; rdfs:domain rtm:ReproducibilityManifest ; rdfs:label "contentHashes (list of manifest entries)" .
rtm:ociImages          a owl:ObjectProperty   ; rdfs:domain rtm:ReproducibilityManifest ; rdfs:label "ociImages (list of manifest entries)" .
rtm:referencedBy       a owl:ObjectProperty   ; rdfs:label "referencedBy (manifest entry → resources that cite this URI)" .
