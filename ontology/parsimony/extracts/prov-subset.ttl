# SPDX-License-Identifier: CC0-1.0
#
# PROV-O subset (hand-curated for slice 1; replace with MIREOT output in slice 2+).
# Terms enumerated in ontology/parsimony/manifest.yaml.

@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

prov:Activity     a owl:Class ; rdfs:label "Activity" .
prov:Entity       a owl:Class ; rdfs:label "Entity" .
prov:Agent        a owl:Class ; rdfs:label "Agent" .
prov:Person       a owl:Class ; rdfs:subClassOf prov:Agent ; rdfs:label "Person" .
prov:Organization a owl:Class ; rdfs:subClassOf prov:Agent ; rdfs:label "Organization" .
prov:Plan         a owl:Class ; rdfs:label "Plan" .

prov:wasGeneratedBy    a owl:ObjectProperty ; rdfs:domain prov:Entity   ; rdfs:range prov:Activity .
prov:used              a owl:ObjectProperty ; rdfs:domain prov:Activity ; rdfs:range prov:Entity .
prov:wasDerivedFrom    a owl:ObjectProperty ; rdfs:domain prov:Entity   ; rdfs:range prov:Entity .
prov:wasAssociatedWith a owl:ObjectProperty ; rdfs:domain prov:Activity ; rdfs:range prov:Agent .
prov:wasAttributedTo   a owl:ObjectProperty ; rdfs:domain prov:Entity   ; rdfs:range prov:Agent .
prov:startedAtTime     a owl:DatatypeProperty .
prov:endedAtTime       a owl:DatatypeProperty .
prov:atTime            a owl:DatatypeProperty .
prov:atLocation        a owl:ObjectProperty .
prov:hadPlan           a owl:ObjectProperty ; rdfs:domain prov:Activity ; rdfs:range prov:Plan .
prov:wasInformedBy     a owl:ObjectProperty ; rdfs:domain prov:Activity ; rdfs:range prov:Activity .
prov:wasInvalidatedBy  a owl:ObjectProperty ; rdfs:domain prov:Entity   ; rdfs:range prov:Activity .
prov:specializationOf  a owl:ObjectProperty ; rdfs:domain prov:Entity   ; rdfs:range prov:Entity .
